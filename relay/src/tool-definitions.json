  {
    "name": "prepare_photo",
    "description": "Prepare an app-picked attachment locally. Uses project hoop and photo screen defaults. colors is required by the strict schema and used only in color mode; bw uses the existing 2-color grayscale pipeline. Image bytes and pixels never appear in responses. filter selects the shared photo-screen preprocessing; original preserves existing output. threshold is allowed only for silhouette/outline; color and bw (the screen's grayscale color path) reject it.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "attachmentId": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "silhouette",
            "outline",
            "color",
            "bw"
          ]
        },
        "colors": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "widthMm": {
          "type": "number"
        },
        "filter": {
          "type": "string",
          "enum": [
            "original",
            "clean",
            "contrast",
            "threshold"
          ]
        }
      },
      "required": [
        "attachmentId",
        "mode",
        "colors",
        "widthMm",
        "filter"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnly": false,
      "needsUserConfirmation": false,
      "mapsTo": "PhotoService.prepare"
    }
  },
