  {
    "name": "view_attachment",
    "description": "View a consented photo as PNG, preserving aspect ratio, without enlargement; at most 768 pixels on its long edge.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "attachmentId": {
          "type": "string"
        },
        "maxEdgePx": {
          "type": "integer",
          "minimum": 1,
          "maximum": 768
        }
      },
      "required": [
        "attachmentId",
        "maxEdgePx"
      ],
      "additionalProperties": false
    },
    "annotations": {
