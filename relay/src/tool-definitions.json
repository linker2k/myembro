  {
    "name": "set_object_transforms",
    "description": "Set explicit transforms for staged objects.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "transactionId": {
          "type": "string"
        },
        "transforms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "objectId": {
                "type": "string"
              },
              "xMm": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "yMm": {
                "type": "number",
                "minimum": -10000,
                "maximum": 10000
              },
              "rotationDeg": {
                "type": "number"
              },
              "scaleXPercent": {
                "type": "number",
                "minimum": 5,
                "maximum": 2000
              },
              "scaleYPercent": {
                "type": "number",
                "minimum": 5,
                "maximum": 2000
              }
            },
            "required": [
              "objectId",
              "xMm",
              "yMm",
              "rotationDeg",
              "scaleXPercent",
              "scaleYPercent"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "transactionId",
        "transforms"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnly": false,
      "needsUserConfirmation": false,
      "mapsTo": "ProjectCommand.SetTransforms"
    }
  },
