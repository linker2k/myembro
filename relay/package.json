{
  "name": "myembro-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=browser --external:cloudflare:workers --external:node:* --outfile=dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run",
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787"
  },
  "dependencies": { "@modelcontextprotocol/sdk": "1.26.0", "zod": "3.25.76" },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261026.1",
    "@types/node": "24.10.0",
    "esbuild": "0.25.5",
    "miniflare": "4.20260730.0",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wrangler": "4.152.0"
  }
}
