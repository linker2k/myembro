<resources>
    <style name="Theme.Myembro" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/myembro_brand_background</item>
        <item name="android:colorAccent">@color/myembro_brand_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/myembro_brand_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">@font/myembro_sans</item>
    </style>
    <style name="Theme.Myembro.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/myembro_brand_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/myembro_splash_animated</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.Myembro</item>
    </style>
</resources>
