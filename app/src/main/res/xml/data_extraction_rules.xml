<?xml version="1.0" encoding="utf-8"?>
<!-- Android backup and device transfer (API 31+): the AI connection's APP_KEY file never leaves the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="relay_connection.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="relay_connection.xml" />
    </device-transfer>
</data-extraction-rules>
