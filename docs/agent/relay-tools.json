                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
            }
        },
        {
            "name": "reorder_object",
            "description": "Set an object's place in the sewing order (0 = sewn first).",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "objectId": {
                        "type": "string"
                    },
                    "index": {
                        "type": "integer"
                    }
                },
                "required": [
                    "objectId",
                    "index"
                ],
                "additionalProperties": false
            },
            "annotations": {
                "readOnlyHint": false,
