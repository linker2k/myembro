{
    "tools": [
        {
            "name": "get_project",
            "description": "Read the open design: hoop, objects, fonts for add_text, free space around objects and the last sewing check. Lengths are mm; the hoop center is (0,0), x grows to the right and y grows downward.",
            "inputSchema": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
            },
            "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true,
                "openWorldHint": false
            }
        },
        {
            "name": "render_preview",
            "description": "Picture of the design in its hoop as a PNG (widthPx 256-1024, default 512).",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "widthPx": {
                        "type": "integer",
                        "minimum": 256,
                        "maximum": 1024,
                        "default": 512
                    }
                },
                "required": [],
                "additionalProperties": false
            },
            "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true,
                "openWorldHint": false
            }
        },
        {
            "name": "list_fonts",
            "description": "Installed fonts that can write a text (all arguments optional), with allowed heights; get_project already lists them.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "text": {
                        "type": "string",
                        "default": ""
                    },
                    "filters": {
                        "type": "array",
                        "items": {
                            "type": "string",
                            "enum": [
                                "KOREAN",
                                "LATIN",
                                "SCRIPT",
                                "SINGLE_LINE",
                                "OUTLINE"
                            ]
                        },
                        "default": []
                    },
                    "installedOnly": {
                        "type": "boolean",
                        "default": true
                    }
                },
                "required": [],
                "additionalProperties": false
            },
            "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true,
                "openWorldHint": false
            }
        },
        {
            "name": "list_builtin_designs",
            "description": "Built-in designs add_design can place, with their sizes.",
            "inputSchema": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
            },
            "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true,
                "openWorldHint": false
            }
        },
        {
            "name": "get_settings",
            "description": "The chosen machine and the frames set_project_frame accepts.",
            "inputSchema": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
            },
            "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true,
                "openWorldHint": false
            }
        },
        {
            "name": "add_design",
            "description": "Add a built-in design by its assetId from list_builtin_designs.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "assetId": {
                        "type": "string"
                    },
                    "objectId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string",
                        "default": ""
                    }
                },
                "required": [
                    "assetId"
                ],
                "additionalProperties": false
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
            }
        },
        {
            "name": "add_text",
            "description": "Add embroidered text at heightMm; leave out fontId to use the last font used (lastFontKo for Hangul, lastFontEn otherwise). Give xMm/yMm to place its center in the same step.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "objectId": {
                        "type": "string"
                    },
                    "text": {
                        "type": "string"
                    },
                    "fontId": {
                        "type": "string"
                    },
                    "fontRevision": {
                        "type": "string"
                    },
                    "heightMm": {
                        "type": "number",
                        "maximum": 60
                    },
                    "threadColor": {
                        "type": "string",
                        "pattern": "^#[0-9A-Fa-f]{6}$",
                        "default": "#000000"
                    },
                    "singleLineBold": {
                        "type": "boolean",
                        "default": false
                    },
                    "xMm": {
                        "type": "number",
                        "minimum": -10000,
                        "maximum": 10000,
                        "description": "Where the text's center goes, mm from the hoop center (right is positive)."
                    },
                    "yMm": {
                        "type": "number",
                        "minimum": -10000,
                        "maximum": 10000,
                        "description": "Where the text's center goes, mm from the hoop center (down is positive)."
                    }
                },
                "required": [
                    "text",
                    "heightMm"
                ],
                "additionalProperties": false
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
            }
        },
        {
            "name": "replace_text",
            "description": "Change an existing text object's text; font, height and color stay unless given.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "objectId": {
                        "type": "string"
                    },
                    "text": {
                        "type": "string"
                    },
                    "fontId": {
                        "type": "string"
                    },
                    "fontRevision": {
                        "type": "string"
                    },
                    "heightMm": {
                        "type": "number",
                        "maximum": 60
                    },
                    "threadColor": {
                        "type": "string",
                        "pattern": "^#[0-9A-Fa-f]{6}$"
                    },
                    "singleLineBold": {
                        "type": "boolean",
                        "default": false
                    }
                },
                "required": [
                    "objectId",
                    "text"
                ],
                "additionalProperties": false
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
            }
        },
        {
            "name": "set_object_transforms",
            "description": "Move objects so their center is at xMm/yMm; rotation and scale stay unless given.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "transforms": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "objectId": {
                                    "type": "string"
                                },
                                "xMm": {
                                    "type": "number",
                                    "minimum": -10000,
                                    "maximum": 10000
                                },
                                "yMm": {
                                    "type": "number",
                                    "minimum": -10000,
                                    "maximum": 10000
                                },
                                "rotationDeg": {
                                    "type": "number"
                                },
                                "scaleXPercent": {
                                    "type": "number",
                                    "minimum": 5,
                                    "maximum": 2000
                                },
                                "scaleYPercent": {
                                    "type": "number",
                                    "minimum": 5,
                                    "maximum": 2000
                                }
                            },
                            "required": [
                                "objectId",
                                "xMm",
                                "yMm"
                            ],
                            "additionalProperties": false
                        }
                    }
                },
                "required": [
                    "transforms"
                ],
                "additionalProperties": false
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
            }
        },
        {
            "name": "transform_objects",
            "description": "Move, scale or rotate several objects together around their shared center.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "objectIds": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "deltaXMm": {
                        "type": "number",
                        "default": 0
                    },
                    "deltaYMm": {
                        "type": "number",
                        "default": 0
                    },
                    "scaleFactor": {
                        "type": "number",
                        "default": 1
                    },
                    "rotationDeg": {
                        "type": "number",
                        "default": 0
                    }
                },
                "required": [
                    "objectIds"
                ],
                "additionalProperties": false
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
            }
        },
        {
            "name": "mirror_objects",
