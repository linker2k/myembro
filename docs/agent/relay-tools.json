        {
            "name": "set_project_frame",
            "description": "Change the hoop to a frame id from get_settings.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "frameId": {
                        "type": "string"
                    }
                },
                "required": [
                    "frameId"
                ],
                "additionalProperties": false
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
