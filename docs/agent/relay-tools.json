                            "scaleYPercent": {
                                "type": "number",
                                "minimum": 5,
                                "maximum": 2000
                            }
                        },
                        "required": [
                            "xMm",
                            "yMm"
                        ],
                        "additionalProperties": false
                    }
                },
                "required": [
                    "sourceId",
