        {
            "name": "duplicate_object",
            "description": "Copy an object to a new position.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "sourceId": {
                        "type": "string"
                    },
                    "newObjectId": {
                        "type": "string"
                    },
                    "transform": {
                        "type": "object",
                        "properties": {
                            "xMm": {
                                "type": "number",
                                "minimum": -10000,
                                "maximum": 10000
                            },
                            "yMm": {
                                "type": "number",
                                "minimum": -10000,
                                "maximum": 10000
                            },
                            "rotationDeg": {
                                "type": "number"
                            },
                            "scaleXPercent": {
                                "type": "number",
                                "minimum": 5,
                                "maximum": 2000
