            "inputSchema": {
                "type": "object",
                "properties": {
                    "objectIds": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "objectIds"
                ],
                "additionalProperties": false
            },
            "annotations": {
                "readOnlyHint": false,
