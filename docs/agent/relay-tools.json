                "additionalProperties": false
            },
            "annotations": {
                "readOnlyHint": true,
                "idempotentHint": true,
                "openWorldHint": false
            }
        },
        {
            "name": "add_generated_art",
            "description": "Add a prepared photo result to the design.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "resultId": {
                        "type": "string"
                    },
                    "objectId": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    }
                },
                "required": [
                    "resultId",
                    "objectId",
                    "name"
                ],
                "additionalProperties": false
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
            }
        },
        {
            "name": "prepare_photo",
            "description": "Turn a handed-over photo into a stitch design at widthMm; add it with add_generated_art.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "attachmentId": {
                        "type": "string"
                    },
                    "mode": {
                        "type": "string",
                        "enum": [
                            "silhouette",
                            "outline",
                            "color",
                            "bw"
                        ]
                    },
                    "colors": {
                        "type": "integer",
                        "minimum": 2,
                        "maximum": 6
                    },
                    "widthMm": {
                        "type": "number"
                    },
                    "filter": {
                        "type": "string",
                        "enum": [
                            "original",
                            "clean",
                            "contrast",
                            "threshold"
                        ]
                    }
                },
                "required": [
                    "attachmentId",
                    "mode",
                    "colors",
                    "widthMm",
                    "filter"
                ],
                "additionalProperties": false
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
            }
        },
        {
            "name": "import_picture",
            "description": "Put a picture you drew into the open design as embroidery, in one undoable step; the answer has the sewing check. SVG is preferred (format svg, the SVG text itself in data): flat shapes with solid fills, at most 4788 bytes and 14 elements, no text, gradients or images; it keeps its own fill colors. PNG or JPEG go in data as base64 and must be small (at most 1000000 base64 characters, few flat colors); colors 2-6 (default 4) sets their thread colors. Each picture becomes its own layer, named title (default 'AI picture n') and your app's name. If it is too large, ask the user to share the picture to myembro instead.",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "format": {
                        "type": "string",
                        "enum": [
                            "svg",
                            "png",
                            "jpeg"
                        ]
                    },
                    "data": {
                        "type": "string"
                    },
                    "colors": {
                        "type": "integer",
                        "minimum": 2,
                        "maximum": 6,
                        "default": 4
                    },
                    "title": {
                        "type": "string",
                        "default": ""
                    }
                },
                "required": [
                    "format",
                    "data"
                ],
                "additionalProperties": false
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
            }
        }
    ]
}
