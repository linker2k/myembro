        {
            "name": "remove_objects",
            "description": "Remove objects. The phone asks the user first (up to 90 s); tell them: Please confirm on the phone in myembro (휴대폰 myembro에서 확인해 주세요).",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "objectIds": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "required": [
                    "objectIds"
                ],
                "additionalProperties": false
