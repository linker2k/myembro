                "additionalProperties": false
            },
            "annotations": {
                "readOnlyHint": false,
                "destructiveHint": false,
                "idempotentHint": false,
                "openWorldHint": false
            }
        },
        {
            "name": "recolor_object",
            "description": "Change one thread color of an object (threadIndex 0 = first color).",
            "inputSchema": {
                "type": "object",
                "properties": {
                    "objectId": {
                        "type": "string"
                    },
                    "threadIndex": {
                        "type": "integer",
